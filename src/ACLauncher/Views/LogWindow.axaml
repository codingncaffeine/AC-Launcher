<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ACLauncher.Views.LogWindow"
        Classes="launcher"
        Title="AC Launcher — Log"
        Width="980" Height="560" MinWidth="500" MinHeight="300">
  <DockPanel Margin="12">
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,10,0,0">
      <CheckBox x:Name="AutoScroll" Content="Follow new entries" IsChecked="True" />
      <Button Grid.Column="2" Content="Open log folder" Click="OnOpenFolder" Margin="0,0,6,0" />
      <Button Grid.Column="3" Content="Clear view" Click="OnClear" />
    </Grid>
    <Border Classes="panel">
      <ListBox x:Name="LogList" Background="Transparent" FontFamily="monospace" FontSize="12" />
    </Border>
  </DockPanel>
</Window>
