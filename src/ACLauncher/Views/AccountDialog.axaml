<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ACLauncher.Views.AccountDialog"
        Classes="launcher"
        Title="Account"
        Width="440" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="18" Spacing="8">
    <TextBlock Classes="label" Text="User name" />
    <TextBox x:Name="UsernameBox" />

    <TextBlock Classes="label" Text="Password" />
    <Grid ColumnDefinitions="*,Auto">
      <TextBox x:Name="PasswordBox" PasswordChar="•" />
      <CheckBox x:Name="ShowPassword" Grid.Column="1" Content="Show" Margin="8,0,0,0"
                IsCheckedChanged="OnShowPasswordChanged" />
    </Grid>

    <TextBlock Classes="label" Text="Display name (optional)" />
    <TextBox x:Name="AliasBox" />

    <TextBlock x:Name="ErrorText" Classes="hint error" TextWrapping="Wrap" IsVisible="False" />
    <TextBlock Classes="dim" TextWrapping="Wrap"
               Text="The password is kept in your desktop keyring when one is available, otherwise in accounts.json in your config folder, readable only by you." />

    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,8,0,0">
      <Button Classes="accent" Content="Save" Click="OnSave" IsDefault="True" MinWidth="80" HorizontalContentAlignment="Center" />
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" MinWidth="80" HorizontalContentAlignment="Center" />
    </StackPanel>
  </StackPanel>
</Window>
